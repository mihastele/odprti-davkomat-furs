# OpenDavki configuration. Copy to `.env` (git-ignored) and edit. Real environment variables override this file.
# Every key is optional; the values below are the defaults.

# --- Exchange rates (conversion of foreign-currency amounts to EUR) ---------------------------------------------
# Source of rates, one of:
#   ECB   European Central Bank euro foreign exchange reference rates (default; the maintainers state FURS recommends them, see docs/fx.md)
#   BSI   Bank of Slovenia list of ECB reference rates; requires OPENDAVKI_FX_BSI_URL (UNVERIFIED, see docs/fx.md)
#   FILE  your own CSV (header: date,currency,rate; rate = foreign units per 1 EUR); requires OPENDAVKI_FX_FILE
OPENDAVKI_FX_SOURCE=ECB

# What to do when the source has no rate for the transaction date (weekends, holidays):
#   PREVIOUS  use the latest earlier published rate, up to OPENDAVKI_FX_MAX_LOOKBACK_DAYS back (reported in the audit trail)
#   FAIL      stop with an error
OPENDAVKI_FX_MISSING_DAY=PREVIOUS
OPENDAVKI_FX_MAX_LOOKBACK_DAYS=7

# Where downloaded rate tables are cached (refreshed after 12 hours, or when a newer date is needed).
OPENDAVKI_FX_CACHE_DIR=.opendavki/cache/fx

# Source locations. The ECB URL normally never needs changing.
OPENDAVKI_FX_ECB_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-hist.xml
OPENDAVKI_FX_BSI_URL=
OPENDAVKI_FX_FILE=

# --- Tax engine ------------------------------------------------------------------------------------------------
# Add broker fees to the purchase cost and deduct them from the sale value (unit values in the declaration).
# Believed to follow the ZDoh-2 acquisition-cost rules but NOT verified (docs/tax-engine.md, BACKLOG T-01).
OPENDAVKI_INCLUDE_FEES=true
