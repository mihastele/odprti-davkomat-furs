<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/NF_VraciloPoplave_1.xsd"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
  targetNamespace="http://edavki.durs.si/Documents/Schemas/NF_VraciloPoplave_1.xsd"
  elementFormDefault="qualified">

  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="Data" minOccurs="0"/>
              <xs:element ref="TForceMajeure" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element ref="TTempWaitingForWork" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element ref="TReimbursementOfWages" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element ref="TIneligibilityReasons" minOccurs="0" maxOccurs="unbounded"/> 
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="Data">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Period" type="xs:date" minOccurs="0" />     
        <xs:element name="Key" type="xs:string" minOccurs="0" maxOccurs="1" />
        <xs:element name="TelephoneNumber" type="xs:string"  minOccurs="0" maxOccurs="1" /> <!--Telefonska številka-->
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="TForceMajeure">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Checked" type="xs:boolean"  minOccurs="0"/> <!--Kljukica-->
        <xs:element name="Month" type="xs:int"  minOccurs="0"/> <!-- Mesec-->
        <xs:element name="Year" type="xs:int"  minOccurs="0"/> <!-- Leto-->
       <xs:element name="IssuedDecision" type="xs:boolean"  minOccurs="0"/> <!--Odločba izdana-->
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="TTempWaitingForWork">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Checked" type="xs:boolean"  minOccurs="0"/> <!--Kljukica-->
        <xs:element name="Month" type="xs:int"  minOccurs="0"/>  <!--Mesec-->
        <xs:element name="Year" type="xs:int"  minOccurs="0"/>  <!--Leto-->
        <xs:element name="IssuedDecision" type="xs:boolean"  minOccurs="0"/> <!--Odločba izdana-->
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
   <xs:element name="TReimbursementOfWages">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Checked" type="xs:boolean"  minOccurs="0"/> <!--Kljukica-->
        <xs:element name="Month" type="xs:int"  minOccurs="0"/>  <!--Mesec-->
        <xs:element name="Year" type="xs:int"  minOccurs="0"/>  <!--Leto-->
        <xs:element name="IssuedDecision" type="xs:boolean"  minOccurs="0"/> <!--Odločba izdana-->
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
   <xs:element name="TIneligibilityReasons">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="BusinessReductionReason" type="xs:boolean"  minOccurs="0"/>
        <xs:element name="ExtraProfitReason" type="xs:boolean"  minOccurs="0"/>
        <xs:element name="OtherReasons" type="xs:boolean"  minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>  

</xs:schema>
