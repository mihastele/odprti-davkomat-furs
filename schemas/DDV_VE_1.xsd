<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/DDV_VE_1.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" targetNamespace="http://edavki.durs.si/Documents/Schemas/DDV_VE_1.xsd" elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:AttachmentList" minOccurs="0" />
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent"/>
              <xs:element ref="DDV-VE"/>
              <xs:element name="DDV-VE-Table" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element ref="DDV-VE-TableItem" minOccurs="0" maxOccurs="unbounded"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element ref="DDV-VE-SumTable" minOccurs="0"/>
              <xs:element name="Attachment" minOccurs="0">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="Hash" type="xs:string" minOccurs="0" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="DDV-VE">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="PeriodDate" type="xs:date" minOccurs="1" maxOccurs="1">
          <xs:annotation>
            <xs:documentation>Na dan</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ClaimAsLegalSuccessor" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Zahtevek vlagam kot pravni naslednik</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F04" type="edp:VatNumberType" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Identifikacijska številka izdajatelja računa [04]</xs:documentation>
          </xs:annotation>
        </xs:element>
        <!--Common-->
        <xs:element name="DocumentWorkflowID" type="edp:DocumentIDType" minOccurs="1">
          <xs:annotation>
            <xs:documentation>Vrsta dokumenta - šifra</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="DocumentWorkflowName" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Vrsta dokumenta - naziv</xs:documentation>
          </xs:annotation>
        </xs:element>
        <!-- End Common -->
        <xs:element name="CorrectionForDocument" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Popravek za dokument</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="DDV-VE-TableItem">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="F05" type="xs:int"  minOccurs="0">
          <xs:annotation>
            <xs:documentation>Opis polja F2</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F06" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Številka obrazca DDV-VP</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F07" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Datum obrazca DDV-VP</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F08" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Številka računa</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F09" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Datum računa</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F10" type="edp:Decimal14_2Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Skupna vrednost z računa brez DDV</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F11" type="edp:Decimal14_2Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Vrednost davčne osnove – zahtevani del</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F12" type="edp:Decimal14_2Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Znesek DDV-zahtevani del</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F13" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Datum iznosa blaga</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F14" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Datum vračila DDV kupcu</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="DDV-VE-SumTable">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="SumF10" type="edp:Decimal14_2Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Skupna vrednost z računa brez DDV</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SumF11" type="edp:Decimal14_2Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Vrednost davčne osnove – zahtevani del</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SumF12" type="edp:Decimal14_2Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Znesek DDV-zahtevani del</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
