<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/NF_IzrVr_1.xsd"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
  targetNamespace="http://edavki.durs.si/Documents/Schemas/NF_IzrVr_1.xsd"
  elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>
  
  <!-- Vloga za izravnave in vračila -->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:AttachmentList" minOccurs="0" />
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="Data"/>
              <xs:element ref="OrderData" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Data">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Period" type="xs:date" minOccurs="0" />
        <xs:element name="PhoneNumber" type="xs:string" minOccurs="0" />
        <xs:element name="Email" type="xs:string" minOccurs="0" />
        <xs:element name="TIP_IZRAVNAVE" type="xs:string" minOccurs="0" /> <!-- izbira1 = "Z";izbira2 = "ZN" -->
        <xs:element name="TIP_VLOGE" type="xs:string" minOccurs="0" /> <!-- izbira3 ? "PL" : "IZ" -->
        <xs:element name="VRACILO" type="xs:string" minOccurs="0" /> <!-- izbira3 ? "X" : (empty) -->
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="OrderData">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Izravnava" type="xs:boolean" minOccurs="0" />
        <xs:element name="OPBEL" type="xs:string" minOccurs="0" /> <!--OPBEL-->
        <xs:element name="Vktyp" type="xs:string" minOccurs="0" /><!--Konto - Naziv konta-->
        <xs:element name="VktypText" type="xs:string" minOccurs="0" /> <!--Konto - Naziv konta-->
        <xs:element name="Opis" type="xs:string" minOccurs="0" /> <!--Opis knjižbe-->
        <xs:element name="DatumZapadlosti" type="xs:date" minOccurs="0" /><!--Datum zapadlosti-->
        <xs:element name="Dobro" type="xs:decimal" minOccurs="0" /><!--Stanje v dobro-->
      </xs:sequence>
    </xs:complexType>
  </xs:element>
 

</xs:schema>
