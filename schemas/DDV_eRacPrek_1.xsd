<?xml version="1.0" encoding="utf-8" ?>
<xs:schema targetNamespace="http://edavki.durs.si/Documents/Schemas/DDV_eRacPrek_1.xsd" elementFormDefault="qualified"
  xmlns="http://edavki.durs.si/Documents/Schemas/DDV_eRacPrek_1.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"
    id="EDP-Common-1" />
  <xs:element name="DDV_eRacPrek">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="TaxPayerPhone" type="xs:string" minOccurs="0" />
        <xs:element name="TaxPayerFax" type="xs:string" minOccurs="0" />
        <xs:element name="TaxPayerEmail" type="xs:string" minOccurs="0" />
        <xs:element name="StartDate" type="xs:date" minOccurs="0" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header" />
        <xs:element ref="edp:Signatures" />
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent" />
              <xs:element ref="DDV_eRacPrek" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>