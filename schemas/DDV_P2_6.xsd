<?xml version="1.0" encoding="utf-8" ?>
<xs:schema targetNamespace="http://edavki.durs.si/Documents/Schemas/DDV_P2_6.xsd" elementFormDefault="qualified"
  xmlns="http://edavki.durs.si/Documents/Schemas/DDV_P2_6.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"
    id="EDP-Common-1" />
  <xs:element name="DDV_P2">
    <xs:complexType>
      <xs:sequence>
        <!-- 01 : Header -->
        <xs:element name="F2" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Matična številka</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F3" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Firma</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F4" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Skrajšano ime firme</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F5_Ulica" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Naslov firme (ulica)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F5_Naselje" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Naslov firme (naselje)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F5_Post" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Naslov firme (poštna številka)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F5_PostName" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Naslov firme (pošta)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F5_Country" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Naslov firme (država)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F6_Name" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Ime, priimek in naslov stalnega bivališča fizične osebe (ime in priimek)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F6_Ulica" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Ime, priimek in naslov stalnega bivališča fizične osebe (ulica)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F6_Naselje" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Ime, priimek in naslov stalnega bivališča fizične osebe (naselje)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F6_Post" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Ime, priimek in naslov stalnega bivališča fizične osebe (poštna številka)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F6_PostName" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Ime, priimek in naslov stalnega bivališča fizične osebe (pošta)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F6_Country" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Ime, priimek in naslov stalnega bivališča fizične osebe (država)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F7" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Datum predvidenega začetka identifikacije za DDV</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F8_PhoneNumber" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Telefonske številke</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F8_FaxNumber" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Številka telefaksa</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F8_EMail" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Elektronski naslov</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F9" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Številke računov pri bankah in hranilnicah</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F10_Name" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Odgovorna oseba [Ime in priimek in davčna številka] (ime in priimek)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F10_TaxNumber" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Odgovorna oseba [Ime in priimek in davčna številka] (davčna številka)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F11_Name" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Ime in priimek kontaktne osebe (ime)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F11_Surname" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Ime in priimek kontaktne osebe (priimek)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F11_TaxNumber" type="xs:int" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Davčna številka kontaktne osebe</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F11_PhoneNumber" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Telefonska številka kontaktne osebe</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F11a" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Splošni podatki: Prenos podjetja ali dela podjetja</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F12_Activity" minOccurs="0" maxOccurs="3">
          <xs:annotation>
            <xs:documentation>Dejavnost</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Code" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Dejavnost: Šifra in naziv dejavnosti, ki predstavlja večje deleže ustvarjenega prometa (šifra dejavnosti)</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Name" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Dejavnost: Šifra in naziv dejavnosti, ki predstavlja večje deleže ustvarjenega prometa (naziv dejavnosti)</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Percent" type="xs:int" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Dejavnost: Šifra in naziv dejavnosti, ki predstavlja večje deleže ustvarjenega prometa (delež ustvarjenega prometa)</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="F13" type="edp:Decimal14_0Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Promet blaga in storitev: Vrednost doseženega prometa blaga in storitev v preteklih 12 mesecih</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F14" type="edp:Decimal14_0Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Promet blaga in storitev: Vrednost pričakovanega prometa blaga in storitev v prihodnjih 12 mesecih</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F15" type="edp:Decimal14_0Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Promet blaga in storitev: Višina katastrskega dohodka v preteklem letu</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F16" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Drugi podatki: Prostovoljna vključitev po prvem odstavku 94. člena ZDDV-1</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F16a" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Drugi podatki: Prostovoljna vključitev po drugem odstavku 94. člena ZDDV-1</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F17" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Drugi podatki: Prostovoljna vključitev po četrtem odstavku 4. člena ZDDV-1</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F18" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Drugi podatki: Skupni znesek pridobitev v tekočem koledarskem letu preseže 10.000 EUR</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F19" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Drugi podatki: Opravljanje in/ali prejem storitev po četrtem odstavku 78. člena ZDDV-1</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="F20" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Drugi podatki: Opravljanje dobav/storitev po 130.c členu ZDDV-1 (unijska ureditev VEM)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Language" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Drugi podatki: Jezik</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="CustodianDate" type="xs:date" minOccurs="0">
        </xs:element>
        <xs:element name="CustodianNote" type="xs:string" minOccurs="0">
        </xs:element>
        <xs:element name="eVEM_DocumentNumber" type="xs:string" minOccurs="0">
        </xs:element>
        <xs:element name="eVEM_DepositNumber" type="xs:dateTime" minOccurs="0">
        </xs:element>
        <xs:element name="CEH_AttachmentNumber" type="xs:string" minOccurs="0">
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header" />
        <xs:element ref="edp:AttachmentList" minOccurs="0" />
        <xs:element ref="edp:Signatures" />
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent" />
              <xs:element ref="DDV_P2" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
