<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/PT_1.xsd" 
  xmlns:xs="http://www.w3.org/2001/XMLSchema" 
  xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" 
  targetNamespace="http://edavki.durs.si/Documents/Schemas/PT_1.xsd" 
  elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent" />
              <xs:element ref="BaseEntity" />             
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--type definitions-->
  <xs:element name="BaseEntity" id="PT">
    <xs:complexType>
      <xs:sequence>
        <!--Common-->
        <xs:element name="DocumentWorkflowID" type="edp:DocumentIDType" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Vrsta dokumenta - šifra</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="DocumentWorkflowName" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Vrsta dokumenta - naziv</xs:documentation>
          </xs:annotation>
        </xs:element>
        <!-- End Common -->
        <!--optional fields-->
        <xs:element name="Period" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Obdobje</xs:documentation>
          </xs:annotation>
        </xs:element>
        
        <xs:element name="Data1" id="Bill" minOccurs="0" maxOccurs="unbounded" >
          <xs:complexType>
            <xs:annotation>
              <xs:documentation>Obračun</xs:documentation>
            </xs:annotation>
            <xs:sequence>
              <xs:element name="F1" id="SequenceNumber" type="xs:int" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Zaporedna številka</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F2" id="InsuranceClass" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Vrsta zavarovanja</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F3" id="PremiumAmmount" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Znesek premije</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F4" id="BillBase" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Osnova za obračun</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F5" id="Tax" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Taksa</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F6" id="InsuranceClassDescription" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Vrsta zavarovanja opis</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="BillSum" type="edp:Decimal14_2Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Obračun skupaj</xs:documentation>
          </xs:annotation>
        </xs:element>

        <xs:element name="Data2" id="BillReduction" minOccurs="0" maxOccurs="unbounded"  >
          <xs:complexType>
            <xs:annotation>
              <xs:documentation>Obračun</xs:documentation>
            </xs:annotation>
            <xs:sequence>
              <xs:element name="F1" id="SequenceNumber2" type="xs:int" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Zaporedna številka</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F2" id="InsuranceClass2" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Vrsta zavarovanja</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F3" id="PremiumAmmount2" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Znesek premije</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F4" id="BillBase2" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Osnova za obračun</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F5" id="Tax2" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Taksa</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F6" id="InsuranceClassDescription2" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Vrsta zavarovanja opis</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>


        <xs:element name="ReductionSum" type="edp:Decimal14_2Type"  minOccurs="0">
          <xs:annotation>
            <xs:documentation>Znižanje kupaj</xs:documentation>
          </xs:annotation>
        </xs:element>
        
        <xs:element name="Sum" type="edp:NegativeDecimal14_2Type"  minOccurs="0">
          <xs:annotation>
            <xs:documentation>Skupaj</xs:documentation>
          </xs:annotation>
        </xs:element>      
        
        
        <xs:element name="CustodianNotes" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Opombe</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="CustodianSubmitDate" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Datum prijave</xs:documentation>
          </xs:annotation>
        </xs:element>
        <!-- end of optional fields-->
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
 
  
  
  
</xs:schema>