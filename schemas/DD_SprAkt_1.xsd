<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/DD_SprAkt_1.xsd"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
  targetNamespace="http://edavki.durs.si/Documents/Schemas/DD_SprAkt_1.xsd"
  elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:AttachmentList" minOccurs="0" />
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="DD_SprAkt"/>
              <xs:element ref="CalcData"/>
              <xs:element ref="PrepaymentEvaluationTable" minOccurs="0" maxOccurs="unbounded" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--type definitions-->
  <xs:element name="DD_SprAkt">
    <xs:complexType>
      <xs:sequence>
        <!--Podatki o davčnem zavezancu-->
        <xs:element name="SkdCode" type="xs:string" minOccurs="0" />
        <xs:element name="SkdName" type="xs:string" minOccurs="0" />
        <xs:element name="ContactName" type="xs:string" minOccurs="0" />
        <xs:element name="ContactLastName" type="xs:string" minOccurs="0" />
        <xs:element name="PhoneNumber" type="xs:string" minOccurs="0" />
        <xs:element name="EmailAddress" type="xs:string" minOccurs="0" />
        <!--Podatki za medletno spremembo višino akontacije-->
        <xs:element name="StartDate" type="xs:date"/>
        <xs:element name="EndDate" type="xs:date"/>
        <xs:element name="TaxBaseType" type="xs:string" minOccurs="0" />
        <xs:element name="TaxBaseTypeN" type="xs:string" minOccurs="0" />
        <xs:element name="PrepaymentType" type="xs:string" minOccurs="0" />
        <xs:element name="PrepaymentTypeN" type="xs:string" minOccurs="0" />
        <xs:element name="Insurance" type="insuranceType" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Vključenost v zavarovanje za namen priznavanja višine normiranih odhodkov</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="IncomeEvaluation" type="xs:decimal" minOccurs="0" />
        <xs:element name="OutcomeEvaluation" type="xs:decimal" minOccurs="0" />

        <xs:element name="ExplanationText" type="xs:string" minOccurs="0" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--Izračunana medletna sprememba višine akontacije-->
  <xs:element name="CalcData">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="TaxBaseEvaluation" type="xs:decimal" minOccurs="0" />
        <xs:element name="TaxLossEvaluation" type="xs:decimal" minOccurs="0" />
        <xs:element name="TaxRate" type="xs:decimal" minOccurs="0" />
        <xs:element name="YearPrepaymentEvaluation" type="xs:decimal" minOccurs="0" />
        <xs:element name="MonthInstalment" type="xs:decimal" minOccurs="0" />
        <xs:element name="ThreeMonthInstalment" type="xs:decimal" minOccurs="0" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
  <!--Lestvica ocenjene višine (letne) akontacije-->
  <xs:element name="PrepaymentEvaluationTable">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Over" type="xs:decimal" minOccurs="0" />
        <xs:element name="Under" type="xs:decimal" minOccurs="0" />
        <xs:element name="TaxAmount" type="xs:decimal" minOccurs="0" />
        <xs:element name="TaxRate" type="xs:decimal" minOccurs="0" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:simpleType name="insuranceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="A" />
      <xs:enumeration value="B" />
      <xs:enumeration value="C" />
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
