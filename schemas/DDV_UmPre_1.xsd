<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/DDV_UmPre_1.xsd"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
  targetNamespace="http://edavki.durs.si/Documents/Schemas/DDV_UmPre_1.xsd"
  elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent"/>
              <xs:element ref="DDV_UmPre"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--type definitions-->
  <xs:element name="DDV_UmPre">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="CorrectionForDocument" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Popravek Dokumenta</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Language" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Jezik</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="TaxPeriodFrom" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>... z naslednjim davčnim obdobjem</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Transactions" minOccurs="0">
          <xs:annotation>
            <xs:documentation>
              Obračunavanje DDV od razlike v ceni na podlagi posebne ureditev za obdavčljive preprodajalce bom uporabljal za naslednje transakcije
            </xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Type" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>tip transakcije</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="1">
                      <xs:annotation>
                        <xs:documentation>dobav umetniških predmetov, zbirk ali starin, ki jih uvozi sam</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation>
                        <xs:documentation>dobav umetniških predmetov, ki mu jih dobavijo njihovi avtorji ali njihovi pravni nasledniki</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="3">
                      <xs:annotation>
                        <xs:documentation>
                          dobav umetniških predmetov, ki mu jih dobavijo drugi davčni zavezanci, ki niso obdavčljivi preprodajalci, 
                          če je bila dobava obdavčena po nižji stopnji DDV v skladu z drugim odstavkom 41. člena tega zakona
                        </xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
