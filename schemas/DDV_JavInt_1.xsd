<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/DDV_JavInt_1.xsd"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
  targetNamespace="http://edavki.durs.si/Documents/Schemas/DDV_JavInt_1.xsd"
  elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent"/>
              <xs:element ref="DDV_JavInt"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--type definitions-->
  <xs:element name="DDV_JavInt">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="CorrectionForDocument" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Popravek Dokumenta</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Language" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Jezik</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="TaxPeriodFrom" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>... z naslednjim davčnim obdobjem</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Acitivities" minOccurs="0">
          <xs:annotation>
            <xs:documentation>... za naslednje dejavnosti v javnem interesu ...</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Type" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>tip dejavnosti</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="1">
                      <xs:annotation>
                        <xs:documentation>1. točka: bolnišnična in izvenbolnišnična zdravstvena oskrba in z njo neposredno povezane dejavnosti ...</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation>
                        <xs:documentation>6. točka: socialno varstvene storitve, vključno s storitvami domov za starejše ...</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="3">
                      <xs:annotation>
                        <xs:documentation>7. točka: storitve varstva otrok in mladostnikov ter dobava blaga in storitev ...</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="4">
                      <xs:annotation>
                        <xs:documentation>8. točka: predšolska vzgoja, šolsko izobraževanje, poklicno usposabljanje in prekvalifikacije ...</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="5">
                      <xs:annotation>
                        <xs:documentation>11. točka: storitve, ki jih svojim članom kot povračilo za članarino, določeno v skladu z njihovimi pravili ...</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="6">
                      <xs:annotation>
                        <xs:documentation>12. točka: storitve, neposredno povezane s športom ali športno vzgojo, ki jih nepridobitne organizacije nudijo osebam ...</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="7">
                      <xs:annotation>
                        <xs:documentation>13. točka: kulturne storitve in z njimi neposredno povezano blago, ki jih opravljajo javni zavodi ...</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Requirements" minOccurs="0">
          <xs:annotation>
            <xs:documentation>ker je/so za oprostitev plačila DDV izpolnjen(i) naslednji pogoj(i) ...</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Type" minOccurs="0" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>tip dejavnosti</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="1">
                      <xs:annotation>
                        <xs:documentation>ne dosegam dobička oziroma dobiček razdelim za nadaljnje opravljanje ali izboljšanje storitev</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation>
                        <xs:documentation>dejavnosti opravljajo in vodijo prostovoljci, ki sami ali preko drugih oseb niso posredno ali neposredno udeleženi v rezultatih teh dejavnosti</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="3">
                      <xs:annotation>
                        <xs:documentation>zaračunavam cene, ki jih odobrijo pristojni organi, ali cene, ki niso višje od takšnih odobrenih cen ...</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="4">
                      <xs:annotation>
                        <xs:documentation>oprostitev DDV za te storitve ne izkrivlja konkurence, na primer postavlja v slabši položaj davčne zavezance, ki obračunavajo DDV</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
