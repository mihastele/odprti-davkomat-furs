<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="NF_Odlocba_1"
    xmlns="http://edavki.durs.si/Documents/Schemas/NF_Odlocba_1.xsd"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
    targetNamespace="http://edavki.durs.si/Documents/Schemas/NF_Odlocba_1.xsd"
    elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent"/>
              <xs:element name="NFOdlocba">
                <xs:annotation>
                  <xs:documentation>Podatki odločbe</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="FormType" type="xs:string" >
                      <xs:annotation>
                        <xs:documentation>Tip dokumenta</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="TaxPeriod" type="xs:long" >
                      <xs:annotation>
                        <xs:documentation>Obdobje</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="DecisionDate" type="xs:date" >
                      <xs:annotation>
                        <xs:documentation>Datum odločbe</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="Notes" type="xs:string" >
                      <xs:annotation>
                        <xs:documentation>Opomba</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="Status" type="xs:string" >
                      <xs:annotation>
                        <xs:documentation>Status</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="Number" type="xs:string" >
                      <xs:annotation>
                        <xs:documentation>Številka odločbe</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
