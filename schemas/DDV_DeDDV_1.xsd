<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/DDV_DeDDV_1.xsd"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
           targetNamespace="http://edavki.durs.si/Documents/Schemas/DDV_DeDDV_1.xsd"
           elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
             schemaLocation="EDP-Common-1.xsd"/>

  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent"/>
              <xs:element ref="DDV_DeDDV"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--type definitions-->
  <xs:element name="DDV_DeDDV">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="ResponsiblePerson" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Odgovorna oseba</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Name" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Ime</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="TaxNumber" type="edp:TaxNumberType" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Davčna številka</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Language" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Jezik</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Date" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Pogoji za prenehanje identifikacije za namene DDV so izpolnjeni dne</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Reason" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Razlogi za prenehanje</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="1">
                <xs:annotation>
                  <xs:documentation>prenehanje opravljanja dejavnosti</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="2">
                <xs:annotation>
                  <xs:documentation>promet pod 50.000€</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="3">
                <xs:annotation>
                  <xs:documentation>pridobivanje blaga pod 10.000€</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="4">
                <xs:annotation>
                  <xs:documentation>prenehanje opravljanja /prejemanja storitev EU</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="5">
                <xs:annotation>
                  <xs:documentation>drugo</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="Remark" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Opomba</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>