<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/DDV_DavObdobje_1.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" targetNamespace="http://edavki.durs.si/Documents/Schemas/DDV_DavObdobje_1.xsd" elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent"/>
              <xs:element ref="DDV_DavObdobje"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Definicija vsebine -->
  <xs:element name="DDV_DavObdobje">
    <xs:complexType>
      <xs:sequence>
        <!-- Telefonska številka davčnega zavezanca (TTaxPayer) -->
        <xs:element name="TelephoneNumber" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Telefonska številka davčnega zavezanca</xs:documentation>
          </xs:annotation>
        </xs:element>

        <!-- Elektronski naslov davčnega zavezanca (TTaxPayer) -->
        <xs:element name="Email" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Elektronski naslov davčnega zavezanca</xs:documentation>
          </xs:annotation>
        </xs:element>

        <!-- Izjava o izpolnjevanju pogojev za določitev mesečnega davčnega obdobja -->
        <xs:element name="EligibilityStatement" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Izjava o izpolnjevanju pogojev za določitev mesečnega davčnega obdobja</xs:documentation>
          </xs:annotation>
        </xs:element>
        <!-- Če je leto veljavnosti izjave enako 9999, velja izjava do preklica! -->
        <xs:element name="EligibilityStatementEndYear" type="xs:int" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Veljavnost (zadnje leto) izjave o izpolnjevanju pogojev za določitev mesečnega davčnega obdobja</xs:documentation>
          </xs:annotation>
        </xs:element>

        <!-- Izjava o preklicu izpolnjevanja pogojev za določitev mesečnega davčnega obdobja -->
        <xs:element name="CancelationOfEligibilityStatement" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Izjava o preklicu izpolnjevanja pogojev za določitev mesečnega davčnega obdobja</xs:documentation>
          </xs:annotation>
        </xs:element>

        <!-- Podatki o obstoječi izjavi iz EDISa -->
        <xs:element name="DdvEdis" minOccurs="0">
          <xs:complexType>
            <xs:annotation>
              <xs:documentation>Podatki o obstoječi izjavi iz EDISa</xs:documentation>
            </xs:annotation>
            <xs:sequence>
              <xs:element name="CanDepositStatement" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Zavezanec izpolnjuje pogoje za oddajo</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="HasActiveStatement" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Zavezanec ima aktivno izjavo</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="FromDate" type="xs:date" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Datum začetka izjave</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="ToDate" type="xs:date" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Datum konca izjave</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>