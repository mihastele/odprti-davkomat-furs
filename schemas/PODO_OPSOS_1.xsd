<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/PODO_OPSOS_1.xsd"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
  targetNamespace="http://edavki.durs.si/Documents/Schemas/PODO_OPSOS_1.xsd"
  elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>
  
  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:AttachmentList" minOccurs="0" />
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="Data"/>
              <xs:element ref="EmployeeData" minOccurs="0" maxOccurs="unbounded"  />
              <xs:element ref="SelfReportData" minOccurs="0" maxOccurs="unbounded"  />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
<!--Obračun prispevka za Sklad za obnovo Slovenije -->
  <xs:element name="Data">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Period" type="xs:date" minOccurs="0" />   
        <xs:element name="TelephoneNumber" type="xs:string" minOccurs="0" /> <!--Telefonska številka-->
        <xs:element name="Email" type="xs:string" minOccurs="0" /> <!--Kontaktna oseba-->
        <xs:element name="EmployeeSum" type="xs:decimal" minOccurs="0" /> <!--Znesek skupnega prispevka delavcev-->
        <xs:element name="EmployerSum" type="xs:decimal" minOccurs="0" /> <!--Prispevek delodajalca-->
        <xs:element name="Sum" type="xs:decimal" minOccurs="0" /> <!--Skupaj za plačilo-->
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--Podatki o posameznih delavcih-->
  <xs:element name="EmployeeData">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="TaxPayerID" type="xs:string" minOccurs="0" /> <!--Davčna številka-->
        <xs:element name="Name" type="xs:string" minOccurs="0" /> <!--Ime-->
        <xs:element name="Surname" type="xs:string" minOccurs="0" /> <!--Priimek-->
        <xs:element name="Amount" type="xs:decimal" minOccurs="0" /> <!--Znesek-->
        <xs:element name="SeqNum" type="xs:int" minOccurs="0" /> <!--interni stevec za napake-->
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
  <!--Podatki v zvezi s predložitvijo obračuna davka na podlagi samoprijave-->
  <xs:element name="SelfReportData">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="EmployeeStartDate" type="xs:date" minOccurs="0" /> <!--Rok za oddajo + 11 dni-->
        <xs:element name="EmployerStartDate" type="xs:date" minOccurs="0" /> <!--Rok za oddajo + 11 dni-->
        <xs:element name="EmployeeContribution" type="xs:decimal" minOccurs="0" /><!--Premalo obračunan znesek obveznosti delavcev-->        
        <xs:element name="EmployerContribution" type="xs:decimal" minOccurs="0" /> <!--Premalo obračunan znesek obveznosti delodajalca-->
        <xs:element name="EmployeeInterest" type="xs:decimal" minOccurs="0" /> <!--Znesek obračunanih obresti delavcev-->
        <xs:element name="EmployerInterest" type="xs:decimal" minOccurs="0" /> <!--Znesek obračunanih obresti delodajalca-->
        <xs:element name="EmployeeSum" type="xs:decimal" minOccurs="0" /> <!--Skupaj Znesek  delavcev -->
        <xs:element name="EmployerSum" type="xs:decimal" minOccurs="0" /> <!--Skupaj Znesek  delodajalca-->
        <xs:element name="SumsSum" type="xs:decimal" minOccurs="0" /> <!--Skupaj za plačilo-->
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
