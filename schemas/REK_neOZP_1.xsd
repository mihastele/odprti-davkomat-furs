<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/REK_neOZP_1.xsd"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
           targetNamespace="http://edavki.durs.si/Documents/Schemas/REK_neOZP_1.xsd"
           elementFormDefault="qualified">

  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header" />
        <xs:element ref="edp:AttachmentList" minOccurs="0" />
        <xs:element ref="edp:Signatures" />
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="Data" />
              <xs:element ref="Insurer" minOccurs="0" maxOccurs="unbounded" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--Obvestilo o nezmožnosti odtegnitve obveznega zdravstvenega prispevka – OZP-->
  <xs:element name="Data">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="CorrectionForDocument" type="xs:string" minOccurs="0" />
        <xs:element name="PaymentDate" type="xs:date" minOccurs="0" />        <!--Datum izplačila-->
        <xs:element name="Period" type="xs:string" minOccurs="0" />           <!--Izplačilo za mesec/obdobje-->
        <xs:element name="TelephoneNumber" type="xs:string" minOccurs="0" />  <!--Telefonska številka-->
        <xs:element name="Email" type="xs:string" minOccurs="0" />            <!--Elektronski naslov-->
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--Podatki o zavarovancih oz. prejemnikih dohodka-->
  <xs:element name="Insurer">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="TaxPayerID" type="xs:string" minOccurs="0" />  <!--Davčna številka-->
        <xs:element name="Name" type="xs:string" minOccurs="0" />        <!--Ime-->
        <xs:element name="Surname" type="xs:string" minOccurs="0" />     <!--Priimek-->
        <xs:element name="Amount" type="xs:decimal" minOccurs="0" />     <!--Znesek dohodka-->
        <xs:element name="IncomeType" type="xs:string" minOccurs="0" />  <!--Vrsta dohodka-->
        <xs:element name="SeqNum" type="xs:int" minOccurs="0" />         <!--Zaporedna številka-->
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>