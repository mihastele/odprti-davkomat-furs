<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://edavki.durs.si/Documents/Schemas/G2G_R_1.xsd"
           xmlns:g2g="http://edavki.durs.si/Documents/Schemas/G2G_V1.xsd"
           targetNamespace="http://edavki.durs.si/Documents/Schemas/G2G_R_1.xsd"
           xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/G2G_V1.xsd"
             schemaLocation="G2G_V1.xsd"/>
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
             schemaLocation="EDP-Common-1.xsd"/>
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent" />
              <xs:element ref="Odgovor"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Odgovor" type="xs:anyType" />
</xs:schema>