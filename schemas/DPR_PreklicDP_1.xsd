<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/DPR_PreklicDP_1.xsd"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
           targetNamespace="http://edavki.durs.si/Documents/Schemas/DPR_PreklicDP_1.xsd"
           elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="PreklicDP"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="PreklicDP">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="DocumentWorkflowID" type="edp:DocumentIDType" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Vrsta dokumenta - šifra</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="DocumentWorkflowName" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Vrsta dokumenta - ime</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SequenceNumber" type="xs:int" minOccurs="0" >
          <xs:annotation>
            <xs:documentation>Preklicujem izbrano namensko digitalno potrdilo za izvajanje postopka davčnega potrjevanja računov</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ReferenceNumber" type="xs:string" minOccurs="0" >
          <xs:annotation>
            <xs:documentation>Preklicujem izbrano namensko digitalno potrdilo za izvajanje postopka davčnega potrjevanja računov</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="RevokeReason" type="xs:string" minOccurs="0" >
          <xs:annotation>
            <xs:documentation>Razlog za preklic</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Explanation" type="xs:string" minOccurs="0" >
          <xs:annotation>
            <xs:documentation>Obrazložitev</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>