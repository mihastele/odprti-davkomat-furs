<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/Vrocanje_PrePE_1.xsd"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
  targetNamespace="http://edavki.durs.si/Documents/Schemas/Vrocanje_PrePE_1.xsd"
  elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:AttachmentList" minOccurs="0" />
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent"/>
              <xs:element ref="Vrocanje_PrePE"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--type definitions-->
  <xs:element name="Vrocanje_PrePE">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="CustodianNotes" type="xs:string" minOccurs="0" >
          <xs:annotation>
            <xs:documentation>Opombe</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="CustodianSubmitDate" type="xs:date" minOccurs="0" >
          <xs:annotation>
            <xs:documentation>Datum prijave</xs:documentation>
          </xs:annotation>
        </xs:element>
        <!-- Podatki o pooblaščencu -->
        <xs:element name="ActivityID" type="xs:string" minOccurs="0" >
          <xs:annotation>
            <xs:documentation>Dejavnost</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="ActivityDescription" type="xs:string" minOccurs="0" >
          <xs:annotation>
            <xs:documentation>Opis dejavnosti</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="VpoID" type="xs:string" minOccurs="0" >
          <xs:annotation>
            <xs:documentation>VPO_ID</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="AuthorizedBy"  minOccurs="0" >
          <xs:annotation>
            <xs:documentation>Preklicujem pooblastilo za vročanje dano s strani zavezanca:</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="TaxPayerID" type="xs:int" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Davčna številka</xs:documentation>
                </xs:annotation>
              </xs:element>              
              <xs:element name="TaxPayerType" type="edp:taxpayerTypeType" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Tip davčnega zavezanca</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Name" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Firma / Ime</xs:documentation>
                </xs:annotation>
              </xs:element>              
              <xs:element name="Address" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Ulica hišna številka</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="City" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Kraj</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Post" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Poštna številka</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="PostName" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Kraj pošte</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="VpoID" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>VPO_ID</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
