<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/NarNePIZ_1.xsd"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
  targetNamespace="http://edavki.durs.si/Documents/Schemas/NarNePIZ_1.xsd"
  elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:AttachmentList" minOccurs="0" />
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="NarNePIZ"/>
              <xs:element ref="NaturalDisaster" minOccurs="0" maxOccurs="unbounded" />
              <xs:element ref="MemberList" minOccurs="0" maxOccurs="unbounded" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--type definitions-->
  <xs:element name="NarNePIZ">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="PhoneNumber" type="xs:string" minOccurs="0" />
        <xs:element name="EmailAddress" type="xs:string" minOccurs="0" />
        <xs:element name="PeriodYear" type="xs:int"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!-- Vrsta nesrece -->
  <xs:element name="NaturalDisaster">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="DisasterCode" type="xs:string" minOccurs="0" />
        <xs:element name="DisasterName" type="xs:string" minOccurs="0" />
        <xs:element name="DateOfDisaster" type="xs:date" minOccurs="0" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--V prvi vrstici so vpisani podatki o vlagatelju vloge. V naslednjih vrsticah so vpisani ostali člani kmečkega gospodinjstva, ki so pokojninsko in invalidsko zavarovani iz naslova opravljanja kmetijske dejavnosti.-->
  <xs:element name="MemberList">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="TaxID" type="xs:string" minOccurs="0" />
        <xs:element name="Firstname" type="xs:string" minOccurs="0" />
        <xs:element name="Lastname" type="xs:string" minOccurs="0" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  

</xs:schema>
