<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/SDD_Ugovor_1.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" targetNamespace="http://edavki.durs.si/Documents/Schemas/SDD_Ugovor_1.xsd" elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>
  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent"/>
              <xs:element ref="Objection"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Objection">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="OrderObjections" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="OrderObjection" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="OrderNumber" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Številka plačilnega naloga</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ReferenceID" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Referenčna oznaka soglasja</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ConsentChangeDate" type="xs:date" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Datum spremembe soglasja</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="PayerAccountNumber" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>IBAN plačnika</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="PayerName" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Naziv plačnika</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="Amount" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Znesek</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:decimal">
                          <xs:totalDigits value="13"/>
                          <xs:fractionDigits value="2"/>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="Purpose" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Namen</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="NetDueDate" type="xs:date" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Neto zapadlost</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="PaymentReceiverAccountNumber" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>IBAN prejemnika plačila</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="PaymentReceiverName" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Naziv prejemnika plačila</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="OrderStatus" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Status naloga</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Agreement" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Izjavljam, da sem seznanjen, da FURS na podlagi tega ugovora, za plačilo zgoraj, ...</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>