      <xs:element minOccurs="1" maxOccurs="1" name="E20" nillable="true" type="money">
        <xs:annotation>
          <xs:documentation>2 - Znesek uveljavljene olajšave za novozaposlene delavce (48. člen ZDoh-1, prvi odstavek)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="E30" nillable="true" type="money">
        <xs:annotation>
          <xs:documentation>3 - Znesek uveljavljene olajšave za delavce, ki prvič sklenejo delovno razmerje (48. člen ZDoh-1, prvi odstavek)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="E40" nillable="true" type="money">
        <xs:annotation>
          <xs:documentation>4 - Znesek uveljavljene olajšave za zaposlitev doktorjev znanosti (48. člen ZDoh-1, drugi odstavek)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="E43" nillable="true" type="money">
        <xs:annotation>
          <xs:documentation>5 - Znesek uveljavljene olajšave za vlaganja v raziskave in razvoj (61. člen ZDoh-2, prvi odstavek)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="E46" nillable="true" type="money">
        <xs:annotation>
          <xs:documentation>6 - Znesek uveljavljene regijske olajšave za vlaganja v raziskave in razvoj (61. člen ZDoh-2, prvi odstavek)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element minOccurs="1" maxOccurs="1" name="E50" nillable="true" type="money">
        <xs:annotation>
          <xs:documentation>7 - Obračunana amortizacija za prevzeta sredstva</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:simpleType name="money">
    <xs:annotation>
      <xs:documentation>Znesek v EUR s centi</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:fractionDigits value="2" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="positivePercent">
    <xs:restriction base="xs:decimal">
      <xs:fractionDigits value="2" />
      <xs:minInclusive value="0" />
