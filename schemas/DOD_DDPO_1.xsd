        <xs:element name="General">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Year" type="xs:int">
                <xs:annotation>
                  <xs:documentation xml:lang="sl">
                    Leto obdobja (vsebuje PeriodStart in PeriodEnd)
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="PeriodStart" type="xs:date" minOccurs="0" />
              <xs:element name="PeriodEnd" type="xs:date" minOccurs="0" />
              <xs:element name="ActivityCode" type="xs:string">
                <xs:annotation>
                  <xs:documentation xml:lang="sl">
                    Sifra dejavnosti
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="DenotationOfTaxBalance" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="sl">
                    Oznaka davcnega obracuna zavezanca (po 6. clenu ZDDPO) 
                  </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="6P">
                      <xs:annotation>
                        <xs:documentation>6P - oznaka davčnega obračuna, ki se nanaša na obdavčljivi del dejavnosti oziroma v primeru, ko davčni zavezanec ne izpolnjuje vseh predpisanih pogojev za popolno oprostitev plačila davka</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="6N">
                      <xs:annotation>
                        <xs:documentation>6N - oznaka davčnega obračuna za del dejavnosti, od katere se davek ne plača, oziroma v primeru, ko davčni zavezanec v celoti izpolnjuje predpisane pogoje za uveljavljanje oprostitve plačila davka</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="AssessmentOfTax_IsIndividual" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="sl">
                    Način ugotavljanja davka (true = Individualno)
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="ProvisionNumber" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="sl">
                    Stevilka odločbe
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="ProvisionDate" type="xs:date" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="sl">
                    Datum izdaje odločbe
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="ProvisionTaxOffice" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="sl">
                    Davčni urad izdaje odlocbe
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="NameOfProposer" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="sl">
                    Naziv predlagatelja
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Address1OfProposer" type="xs:string" minOccurs="0" />
              <xs:element name="Address2OfProposer" type="xs:string" minOccurs="0" />
              <xs:element name="CityOfProposer" type="xs:string" minOccurs="0" />
              <xs:element name="TaxNumberOfProposer" type="xs:int" minOccurs="0" />
              <xs:element name="IsTaxPayerUserOfEconomicZone" type="xs:boolean" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="sl">
                    Davcni zavezanec je uporabnik ekonomske cone
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="EconomicZone_Number" type="xs:string" minOccurs="0" />
              <xs:element name="EconomicZone_Date" type="xs:date" minOccurs="0" />
              <xs:element name="EconomicZone_TaxOffice" type="xs:string" minOccurs="0" />
              <xs:element name="StatedBalanceRelatingTo" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="sl">
                    Navedeni obracun se nanasa na...
                  </xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:int">
                    <xs:enumeration value="1">
                      <xs:annotation>
                        <xs:documentation>dejavnosti v ekonomski coni</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="2">
                      <xs:annotation>
                        <xs:documentation>Dejavnosti izven ekonomske cone</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="3">
                      <xs:annotation>
                        <xs:documentation>Celotno poslovanje</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element name="BusinessYearStart" type="xs:date" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="sl">
                    Zacetek poslovnega leta (ce je koledarsko, elementa ni)
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="BusinessYearEnd" type="xs:date" minOccurs="0">
                <xs:annotation>
                  <xs:documentation xml:lang="sl">
                    Konec poslovnega leta (ce je koledarsko, elementa ni)
                  </xs:documentation>
                </xs:annotation>
              </xs:element>
