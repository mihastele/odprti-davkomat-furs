<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/DAC7_Nicelno_1.xsd"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
  targetNamespace="http://edavki.durs.si/Documents/Schemas/DAC7_Nicelno_1.xsd"
  elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:AttachmentList" minOccurs="0" />
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="DAC7_Nicelno"/>
			        <xs:element ref="PlatformBusiness" minOccurs="0" maxOccurs="unbounded"/>		  
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="DAC7_Nicelno">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="PeriodYear" type="xs:int" minOccurs="0"/>
        <xs:element name="PhoneNumber" type="xs:string" minOccurs="0" />
        <xs:element name="EmailAddress" type="xs:string" minOccurs="0" />
        <xs:element name="Statement" type="xs:boolean" minOccurs="0"/>
        <xs:element name="Nexus" type="xs:string" minOccurs="0" />
        <xs:element name="NexusN" type="xs:string" minOccurs="0" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
   <xs:element name="PlatformBusiness">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="PlatformBusinessName" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>   
 
  <!--type definitions-->
  <xs:simpleType name="Amount_Type">
    <xs:restriction base="xs:decimal">
      <xs:fractionDigits value="0"/>
    </xs:restriction>
  </xs:simpleType>
  

</xs:schema>
