<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/Doh_Zap2_3.xsd"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
  targetNamespace="http://edavki.durs.si/Documents/Schemas/Doh_Zap2_3.xsd"
  elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:AttachmentList" minOccurs="0" />
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent"/>
              <xs:element ref="Doh_Zap2"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--type definitions-->
  <xs:element name="Doh_Zap2">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="subversion" type="xs:int" minOccurs="0">
          <xs:annotation>
            <xs:documentation>podverzija sheme / 2 - ce je Datum prejema dohodka >= 1.1.2022(iz konfiguracije)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="CorrectionForDocument" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Popravek Dokumenta</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="DocumentWorkflowID" type="edp:DocumentIDType" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Vrsta dokumenta - šifra</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="PaymentType" type="xs:int" minOccurs="0" >
          <xs:annotation>
            <xs:documentation>Vlagam</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="PaymentDate" type="xs:date" minOccurs="0" >
          <xs:annotation>
            <xs:documentation>Datum prejema dohodka</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="EmailAddress" type="xs:string" minOccurs="0" >
          <xs:annotation>
            <xs:documentation>Elektronski naslov</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="TelephoneNumber" type="xs:string" minOccurs="0" >
          <xs:annotation>
            <xs:documentation>Telefonska številka</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="OtherIncomeDataOption1" type="xs:boolean" minOccurs="0" default="false">
          <xs:annotation>
            <xs:documentation>Zavezanec ni zavarovanec po 15. ali 20. členu ZZVZZ</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="OtherIncomeDataOption2" type="xs:boolean" minOccurs="0" default="false">
          <xs:annotation>
            <xs:documentation>Zavezanec ni vključen v obvezno PIZ za polni delovni ali zavarovalni čas in ni upokojenec</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="OtherIncomeDataOption3" type="xs:boolean" minOccurs="0" default="false">
          <xs:annotation>
            <xs:documentation>Za zavezanca se glede plačila prispevkov uporablja zakonodaja druge države članice EU</xs:documentation>
          </xs:annotation>
        </xs:element>

        <xs:element name="IncomePayer" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation>Podatki o izplačevalcu dohodka</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Name" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Ime in priimek oziroma firma</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Address" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Naslov oziroma sedež</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Country" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Država</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="TaxNumber" type="xs:int" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Davčna številka ali</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="IdentificationNumber" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Identifikacijska številka</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="OtherEmployer" type="xs:boolean" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Glavni delodajalec</xs:documentation>
                </xs:annotation>
              </xs:element>

            <xs:element name="IncomeData" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Podatki o dohodku iz delovnega razmerja</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="IncomePayer" type="xs:string" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Izplačevalec</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PaymentDate" type="xs:date" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Datum prejema dohodka</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PaymentForMonth" type="xs:int" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Izplačilo za mesec</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PaymentForYear" type="xs:int" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Izplačilo za mesec: leto</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PaymentFromMonth" type="xs:int" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Izplačilo za obdobje: od</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PaymentFromYear" type="xs:int" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Izplačilo za obdobje: od leta</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PaymentToMonth" type="xs:int" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Izplačilo za obdobje: do</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PaymentToYear" type="xs:int" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Izplačilo za obdobje: do leta</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="Type" type="xs:string" minOccurs="0" >
                    <xs:annotation>
                      <xs:documentation>Vrsta dohodka</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="TaxBaseReduction_a" type="xs:boolean" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Za šifre vrst dohodkov 1111, 1103/1090 in 1103/1127 - do višine 100 % povprečne plače v Sloveniji</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="TaxBaseReduction_b" type="xs:boolean" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Za šifre vrst dohodkov 1111, 1103/1090 in 1103/1127 - do višine 100 % povprečne mesečne plače delavca, ki znaša ______eur (velja samo za 1111)</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="TaxBaseReduction_c" type="xs:boolean" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Za šifre vrst dohodkov 1111, 1103/1090 in 1103/1127 - ne želim zmanjšanja davčne osnove</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="TaxBaseReduction_value" type="edp:Decimal14_2Type" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Za šifre vrst dohodkov 1111, 1103/1090 in 1103/1127 - .. ki znaša ______eur (velja samo za 1111)</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="Income" type="edp:Decimal14_2Type" minOccurs="0" >
                    <xs:annotation>
                      <xs:documentation>Dohodek</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="Contribution" type="edp:Decimal14_2Type" minOccurs="0" >
                    <xs:annotation>
                      <xs:documentation>Obvezni prispevki za socialno varnost</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="CountryOfEmployment" type="xs:string" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Država opravljanja zaposlitve</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="CountryOrInternationalOrganisationOfIncomePayments" type="xs:string" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Država/Mednarodna organizacija, izplačevalka dohodka</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="TaxDeduction" type="xs:boolean" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Uveljavljam oprostitev plačila dohodnine v skladu z mednarodno pogodbo o izogibanju dvojnega obdavčevanja dohodka *</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="IncomePaymentFixedPeriodOption" type="xs:boolean" minOccurs="0" default="false">
                    <xs:annotation>
                      <xs:documentation>Dohodek se bo izplačeval za določen čas</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="IncomePaymentFixedPeriodEndDate" type="xs:date" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>do vključno</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="IncomePaymentIndefinatePeriodOption" type="xs:boolean" minOccurs="0" default="false">
                    <xs:annotation>
                      <xs:documentation>Dohodek se bo izplačeval za nedoločen čas</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="FieldAllowance" type="edp:Decimal14_2Type" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Terenski dodatek</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="DailyAllowance" type="edp:Decimal14_2Type" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Povračilo stroškov službene poti – dnevnice</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="TransportationAllowance" type="edp:Decimal14_2Type" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Povračilo stroškov službene poti – prevoz</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="AccommodationAllowance" type="edp:Decimal14_2Type" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Povračilo stroškov službene poti – prenočišče</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="SloveniaFoodAllowanceUnderLimit" type="edp:Decimal14_2Type" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Povračilo stroškov prehrane v zvezi z začasno napotitvijo na delo v Slovenijo do največ 30 dni ali 90 dni</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="SloveniaFoodAllowanceOverLimit" type="edp:Decimal14_2Type" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Povračilo stroškov prehrane v zvezi z začasno napotitvijo na delo v Slovenijo nad 30 dni ali 90 dni</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="TemporarySloveniaTransportationAllowance" type="edp:Decimal14_2Type" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Povračilo stroškov prevoza v zvezi z začasno napotitvijo na delo v Slovenijo</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="TemporarySloveniaTransportationStartEndAllowance" type="edp:Decimal14_2Type" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Povračilo stroškov prevoza ob začetku in koncu začasne napotitve na delo v Slovenijo</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="TemporarySloveniaAccommodationAllowance" type="edp:Decimal14_2Type" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Povračila stroškov za prenočišče v zvezi z začasno napotitvijo na delo v Slovenijo do največ 90 dni</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PostedToWorkSloveniaWithLawInfo" type="xs:boolean" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Napoten na čezmejno opravljanje dela v skladu s 45.a členom ZDoh-2</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PostedToWorkSloveniaWithLawInfoDate" type="xs:date" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Datum prve napotitve na čezmejno opravljanje dela</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="MonthNumberWithLawInfo" type="xs:int" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Zaporedna številka meseca uveljavljanja posebne davčne osnove v skladu s 45.a členom ZDoh-2</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>

            <xs:element name="IncomeDataOther" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Podatki o dohodku iz drugega pogodbenega razmerja</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="IncomePayer" type="xs:string" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Izplačevalec</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PaymentDate" type="xs:date" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Datum prejema dohodka</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PaymentForMonth" type="xs:int" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Izplačilo za mesec</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="PaymentForYear" type="xs:int" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Izplačilo za mesec: leto</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="Type" type="xs:string" minOccurs="0" >
                    <xs:annotation>
                      <xs:documentation>Vrsta dohodka</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="Income" type="edp:Decimal14_2Type" minOccurs="0" >
                    <xs:annotation>
                      <xs:documentation>Dohodek</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="ActualCostTransportationAndAccomodation" type="edp:Decimal14_2Type" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Uveljavljam dejanske stroške prevoza in nočitve v znesku</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="SocialSecurityTax" type="edp:Decimal14_2Type" minOccurs="0" >
                    <xs:annotation>
                      <xs:documentation>Obvezni prispevki za socialno varnost</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="DerivativePersonalSupplementalWork" type="edp:Decimal14_2Type" minOccurs="0" >
                    <xs:annotation>
                      <xs:documentation>Vplačana vrednotnica za osebno dopolnilno delo</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="CountryOrInternationalOrganisationOfIncomePayments" type="xs:string" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Država/Mednarodna organizacija, izplačevalka dohodka</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="TaxDeduction" type="xs:boolean" minOccurs="0">
                    <xs:annotation>
                      <xs:documentation>Uveljavljam oprostitev plačila dohodnine v skladu z mednarodno pogodbo o izogibanju dvojnega obdavčevanja dohodka *</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>

            <xs:element name="CostAnalysis" minOccurs="0" maxOccurs="unbounded">
              <xs:annotation>
                <xs:documentation>Razčlenitev dejanskih stroškov prevoza in nočitve</xs:documentation>
              </xs:annotation>
              <xs:complexType>
                <xs:sequence>
                  <xs:element name="Description" type="xs:string" minOccurs="0" >
                    <xs:annotation>
                      <xs:documentation>Opis</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                  <xs:element name="Amount" type="edp:Decimal14_2Type" minOccurs="0" >
                    <xs:annotation>
                      <xs:documentation>Znesek</xs:documentation>
                    </xs:annotation>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>

        <xs:element name="StatementInfo" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation>Oprostitev plačila akontacije dohodnine od dohodka iz zaposlitve</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Type" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Type</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Paragraph" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Paragraph</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Article" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Article</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="Country" type="xs:string" minOccurs="0" >
                <xs:annotation>
                  <xs:documentation>Country</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <xs:element name="CustodianNotes" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Skrbniške opombe</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="CustodianSubmitDate" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Datum oddaje skrbnika</xs:documentation>
          </xs:annotation>
        </xs:element>

      </xs:sequence>
    </xs:complexType>

  </xs:element>

  <xs:simpleType name="Decimal14_2Type">
    <xs:restriction base="xs:decimal">
      <xs:pattern value="\d{1,14}(\.\d{1,2})?" />
    </xs:restriction>
  </xs:simpleType>

</xs:schema>
