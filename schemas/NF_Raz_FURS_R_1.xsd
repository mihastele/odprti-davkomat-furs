<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/NF_Raz_FURS_R_1.xsd"
           xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
           targetNamespace="http://edavki.durs.si/Documents/Schemas/NF_Raz_FURS_R_1.xsd"
           elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <!--document structure-->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="TWorkflow" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element ref="TaxPayerInfo" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="TWorkflow">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="DocumentWorkflowID" type="edp:DocumentIDType" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Vrsta dokumenta - šifra</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="DocumentWorkflowName" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Vrsta dokumenta - ime</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="TaxPayerInfo">
    <xs:complexType>
      <xs:annotation>
        <xs:documentation>Podatki o ponudniku</xs:documentation>
      </xs:annotation>
      <xs:sequence>
        <xs:element name="TaxNumber" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Davčna številka</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Name" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Naziv</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="DatumPreverjanja" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Datum preverjanja</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="SteviloMesecev" type="xs:int" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Število mesecev</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="DavcniDolg" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Ima davčni dolg</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="NeoddaniREK" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Ima neoddane REK obračune</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="UstrezaPogojem" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Nima davčnega dolga in nima neoddanih REK obračunov</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>