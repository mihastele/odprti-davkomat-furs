<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://edavki.durs.si/Documents/Schemas/PD_Obv_1.xsd" elementFormDefault="qualified" xmlns="http://edavki.durs.si/Documents/Schemas/PD_Obv_1.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd" id="EDP-Common-1" />
  <xs:element name="PD_Obv">
    <xs:complexType>
      <xs:sequence>
        
        <xs:element name="Name" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Odgovorna oseba.</xs:documentation>
          </xs:annotation>
        </xs:element>

        <xs:element name="TaxNumber" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Davčna številka odgovorne osebe.</xs:documentation>
          </xs:annotation>
        </xs:element>

        <xs:element name="SupplyStatus" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Pričetek/Prenehanje dobave blaga in storitev.</xs:documentation>
          </xs:annotation>
        </xs:element>

        <xs:element name="TaxDate" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">Davčno obdobje.</xs:documentation>
          </xs:annotation>
        </xs:element>
        
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header" />
        <xs:element ref="edp:Signatures" />
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent" />
              <xs:element ref="PD_Obv" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>