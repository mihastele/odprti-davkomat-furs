<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/NF_Upnik_1.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" targetNamespace="http://edavki.durs.si/Documents/Schemas/NF_Upnik_1.xsd" elementFormDefault="qualified">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:AttachmentList"/>
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="Upnik"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="Upnik">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="TaxNumber" type="edp:TaxNumberType" minOccurs="0"/>
        <xs:element name="Sum" type="xs:decimal"  minOccurs="0" />
        <xs:element name="SumDDV" type="xs:decimal"  minOccurs="0" />
        <xs:element name="Email" type="xs:string"  minOccurs="0" maxOccurs="1" />
        <xs:element name="TelephoneNumber" type="xs:string"  minOccurs="0" maxOccurs="1" />
        <xs:element name="Dolzniki" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Dolznik" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:annotation>
                    <xs:documentation>Data1 Opis</xs:documentation>
                  </xs:annotation>
                  <xs:sequence>
                    <xs:element name="Stevec" type="xs:int">
                      <xs:annotation>
                        <xs:documentation>Stevec</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="IdPrijave" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Id Prijave</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="TaxNumber" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>davcna stevilka</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="Naziv" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Naziv</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="DatumRacuna" type="xs:date" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Datum Racuna</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="DatumZamude" type="xs:date" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>DatumZamude</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="OznakaRacuna" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>OznakaRacuna</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ZnesekObveznosti" type="xs:decimal" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>ZnesekObveznosti</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ZnesekDDV" type="xs:decimal" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>ZnesekDDV</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="Status" type="xs:string" minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>Status (samo pri vpogledih)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element name="ZadnjaSprememba" type="xs:date"  minOccurs="0">
                      <xs:annotation>
                        <xs:documentation>ZadnjaSprememba (samo pri vpogledih)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
