<?xml version="1.0" encoding="utf-8"?>

<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/DOD_DDPO_12.xsd" xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" elementFormDefault="qualified" targetNamespace="http://edavki.durs.si/Documents/Schemas/DOD_DDPO_12.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import schemaLocation="EDP-Common-1.xsd" namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" />
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header" />
        <xs:element ref="edp:AttachmentList" minOccurs="0" />
        <xs:element ref="edp:Signatures" />
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent" />
              <xs:element ref="DOD_DDPO" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="DOD_DDPO">
    <xs:complexType>
      <xs:annotation>
        <xs:documentation>Obračun davka od dohodkov pravnih oseb</xs:documentation>
      </xs:annotation>
      <xs:sequence>
        <xs:element minOccurs="1" maxOccurs="1" name="PeriodStart" type="xs:dateTime">
          <xs:annotation>
            <xs:documentation>Obdobje od</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="PeriodEnd" type="xs:dateTime">
          <xs:annotation>
            <xs:documentation>Obdobje do</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="TaxSubjectExt">
          <xs:complexType>
            <xs:annotation>
              <xs:documentation>Dodatni podatki o zavezancu</xs:documentation>
            </xs:annotation>
            <xs:sequence>
              <xs:element minOccurs="1" maxOccurs="1" name="ActivitySkdCode">
                <xs:annotation>
                  <xs:documentation>Šifra vrste dejavnosti po SKD</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:length value="5" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="1" maxOccurs="1" name="PredominantActivityCode">
                <xs:annotation>
                  <xs:documentation>Šifra vrste pretežne dejavnosti</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:length value="5" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="1" name="RegistrationNumber" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Matična številka obrata</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="1" maxOccurs="1" name="Resident" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Davčni obračun zavezanca rezidenta, ki ima sedež v Republiki Sloveniji:</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="ContactPerson" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Kontaktna oseba</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="ContactPhone" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Telefonska številka kontaktne osebe</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="ContactEmail" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Email kontaktne osebe</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="ForResidentManagmementSlo" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Davčni obračun zavezanca rezidenta, ki ima kraj dejanskega delovanja poslovodstva v Republiki Sloveniji</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="ForResidentDoubleTaxation" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Davčni obračun zavezanca rezidenta po ZDDPO-2, ki se za namene mednarodne pogodbe o izogibanju dvojnega obdavčevanja šteje za rezidenta (navesti državo pogodbenico)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="ForResidentDoubleTaxationCountryCode">
          <xs:annotation>
            <xs:documentation>Država pogodbenica o izogibanju dvojnega obdavčevanja za davčni obračun zavezanca rezidenta po ZDDPO-2</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:length value="3" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="ForResidentArticle67n" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Davčni obračun zavezanca rezidenta po 67.n členu ZDDPO-2</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="ForNotResident" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Davčni obračun zavezanca nerezidenta po ZDDPO-2, ki se šteje za rezidenta (navesti državo), za dobiček poslovne enote v Republiki Sloveniji</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="ForNotResidentCountryCode">
          <xs:annotation>
            <xs:documentation>Država za davčni obračun zavezanca nerezidenta po ZDDPO-2</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:length value="3" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="ForNotResidentDoubleTaxation" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Davčni obračun zavezanca nerezidenta po ZDDPO-2, ki na podlagi mednarodne pogodbe o izogibanju dvojnega obdavčevanja med Republiko Slovenijo in (navesti državo pogodbenico) v Republiki Sloveniji nima stalne poslovne enote</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="ForNotResidentDoubleTaxationCountryCode">
          <xs:annotation>
            <xs:documentation>Država pogodbenica o izogibanju dvojnega obdavčevanja za davčni obračun zavezanca nerezidenta po ZDDPO-2</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:length value="3" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="UgotavljanjeNorm">
          <xs:annotation>
            <xs:documentation>Podatki v zvezi z ugotavljanjem davčne osnove z upoštevanjem normiranih odhodkov:</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:annotation>
              <xs:documentation>Vrsta oddanega obračuna</xs:documentation>
            </xs:annotation>
            <xs:sequence>
              <xs:element minOccurs="1" maxOccurs="1" name="VrstaOdhodkov">
                <xs:annotation>
                  <xs:documentation>Način ugotavljanja davčne osnove v obdobju, za katerega zavezanec predlaga obračun:</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="Dejanski">
                      <xs:annotation>
                        <xs:documentation>davčni obračun na podlagi dejanskih prihodkov in dejanskih odhodkov</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="Normirani">
                      <xs:annotation>
                        <xs:documentation>davčni obračun na podlagi dejanskih prihodkov in normiranih odhodkov</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="1" maxOccurs="1" name="IsNormNextYear" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Priglasitev ugotavljanja davčne osnove z upoštevanjem normiranih odhodkov v naslednjem davčnem obdobju: </xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="1" maxOccurs="1" name="IsNotNormNextYear" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Obvestilo o prenehanju ugotavljanja davčne osnove z upoštevanjem normiranih odhodkov v naslednjem davčnem obdobju:</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="IsTax9Article" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Davčni obračun zavezanca iz 9. člena ZDDPO-2</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="Tax61Article">
          <xs:annotation>
            <xs:documentation>Davčni obračun v skladu z 61. členom ZDDPO-2</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="None">
                <xs:annotation>
                  <xs:documentation>Davčni obračun NI v skladu z 61. členom ZDDPO-2</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="InvestmenetFund">
                <xs:annotation>
                  <xs:documentation>Obračun investicijskega sklada (prvi odstavek 61. člena)</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="PensionFund">
                <xs:annotation>
                  <xs:documentation>Obračun pokojninskega sklada (drugi odstavek 61. člena)</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="InsuranceBenefitsScheme">
                <xs:annotation>
                  <xs:documentation>Obračun zavarovalnice za izvajanje pokojninskega načrta (tretji odstavek 61. člena)</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="RiskCapital">
                <xs:annotation>
                  <xs:documentation>Obračun družbe tveganega kapitala za izvajanje dopustnih naložb tveganega kapitala (četrti odstavek 61. člena)</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="IsTax16Article" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Davčni zavezanec posluje s povezanimi osebami po 16. členu ZDDPO-2</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="IsTax17Article" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Davčni zavezanec posluje s povezanimi osebami rezidenti po 17. členu ZDDPO-2</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="IsTax17Article6Item" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Davčni zavezanec posluje s povezanimi osebami rezidenti po 17. členu ZDDPO-2 in mora v skladu s šestim odstavkom 17. člena ZDDPO-2 prilagajati davčno osnovo</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="Loan16Article" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Davčni zavezanec prejema ali daje posojila ali izkazuje obresti s povezanimi osebami iz 16. člena ZDDPO-2</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="Loan17Article" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Davčni zavezanec prejema ali daje posojila ali izkazuje obresti s povezanimi osebami rezidenti iz 17. člena ZDDPO-2 in mora v skladu s šestim odstavkom 19. člena ZDDPO-2 prilagajati davčno osnovo</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="IsTaxPayerForCbCR" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Davčni zavezanec je del mednarodne skupine podjetij, katere skupni konsolidirani prihodki v poslovnem letu neposredno pred poslovnim letom poročanja so enaki ali presegajo 750.000.000 evrov</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="LimitCbCR" type="xs:decimal" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Znesek Limit CbCR</xs:documentation>
          </xs:annotation>
        </xs:element>        
        
        <xs:element minOccurs="1" maxOccurs="1" name="TonnageTax">
          <xs:annotation>
            <xs:documentation>Davčni zavezanec, ki ugotavlja davčno osnovo tudi po sistemu davka na tonažo (označite z obkrožitvijo)</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="None">
                <xs:annotation>
                  <xs:documentation>Ni zavezanec po Zakonu o davku na tonažo</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="TonnageZDDPO">
                <xs:annotation>
                  <xs:documentation>Davčni obračun za dejavnosti obdavčene po ZDDPO-2</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="TonnageZDT">
                <xs:annotation>
                  <xs:documentation>Davčni obračun za dejavnosti obdavčene po Zakonu o davku na tonažo</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="AssessmentOfTaxStatus">
          <xs:annotation>
            <xs:documentation>Vrsta oddanega obračuna:</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:annotation>
              <xs:documentation>Vrsta oddanega obračuna</xs:documentation>
            </xs:annotation>
            <xs:sequence>
              <xs:element minOccurs="1" maxOccurs="1" name="IsAssessmentOfTaxRegular" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Redni davčni obračun (358. člen ZDavP-2)</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="1" maxOccurs="1" name="AssessmentOfTaxRegularDetails">
                <xs:annotation>
                  <xs:documentation>Redni davčni obračun (358. člen ZDavP-2) - podatki</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:enumeration value="None">
                      <xs:annotation>
                        <xs:documentation>ni redni davčni obračun</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="RegularYear">
                      <xs:annotation>
                        <xs:documentation>za koledarsko leto</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="FiskalYear">
                      <xs:annotation>
                        <xs:documentation>za poslovno leto, ki je različno od koledarskega leta</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                    <xs:enumeration value="TransitionPeriod">
                      <xs:annotation>
                        <xs:documentation>za prehodno obdobje</xs:documentation>
                      </xs:annotation>
                    </xs:enumeration>
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="1" maxOccurs="1" name="IsStatusChange" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Davčni obračun v primeru statusnih sprememb</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="unbounded" name="StatusChangeDetails">
                <xs:annotation>
                  <xs:documentation>Davčni obračun v primeru statusnih sprememb - podatki</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:annotation>
                    <xs:documentation>Statusne spremembe</xs:documentation>
                  </xs:annotation>
                  <xs:sequence>
                    <xs:element minOccurs="1" maxOccurs="1" name="AssessmentDate" nillable="true" type="xs:dateTime">
                      <xs:annotation>
                        <xs:documentation>Obračunski dan:</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="1" maxOccurs="1" name="RegistrationDate" nillable="true" type="xs:dateTime">
                      <xs:annotation>
                        <xs:documentation>Dan vpisa spremembe v register:</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="1" maxOccurs="1" name="StatusChangeType1">
                      <xs:annotation>
                        <xs:documentation>Združitev/razdelitev/oddelitev/izčlenitev/prenos</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="None">
                            <xs:annotation>
                              <xs:documentation>ni izpolnjeno</xs:documentation>
                            </xs:annotation>
                          </xs:enumeration>
                          <xs:enumeration value="Join">
                            <xs:annotation>
                              <xs:documentation>davčni obračun pri združitvah – pripojitvah ali spojitvah (361. in 362. člen ZDavP-2)</xs:documentation>
                            </xs:annotation>
                          </xs:enumeration>
                          <xs:enumeration value="Divide">
                            <xs:annotation>
                              <xs:documentation>davčni obračun pri razdelitvah (361. in 362. člen ZDavP-2)</xs:documentation>
                            </xs:annotation>
                          </xs:enumeration>
                          <xs:enumeration value="SpinOff">
                            <xs:annotation>
                              <xs:documentation>davčni obračun pri oddelitvah (365. in 366. člen ZDavP-2)</xs:documentation>
                            </xs:annotation>
                          </xs:enumeration>
                          <xs:enumeration value="SpinOut">
                            <xs:annotation>
                              <xs:documentation>davčni obračun pri izčlenitvah</xs:documentation>
                            </xs:annotation>
                          </xs:enumeration>
                          <xs:enumeration value="PropertyTransfer">
                            <xs:annotation>
                              <xs:documentation>davčni obračun pri prenosu premoženja</xs:documentation>
                            </xs:annotation>
                          </xs:enumeration>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="1" maxOccurs="1" name="StatusChangeType2">
                      <xs:annotation>
                        <xs:documentation>Prenosna/prevzemna družba</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="None">
                            <xs:annotation>
                              <xs:documentation>ni izpolnjeno</xs:documentation>
                            </xs:annotation>
                          </xs:enumeration>
                          <xs:enumeration value="Transmission">
                            <xs:annotation>
                              <xs:documentation>davčni obračun prevzete (prenosne) družbe</xs:documentation>
                            </xs:annotation>
                          </xs:enumeration>
                          <xs:enumeration value="Acquiring">
                            <xs:annotation>
                              <xs:documentation>davčni obračun prevzemne družbe</xs:documentation>
                            </xs:annotation>
                          </xs:enumeration>
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element minOccurs="0" maxOccurs="1" name="StatusChangeCompaniesDetails">
                      <xs:annotation>
                        <xs:documentation>Družbe v transakciji</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:sequence>
                          <xs:element minOccurs="0" maxOccurs="unbounded" name="CompaniesData" nillable="true">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element minOccurs="1" maxOccurs="1" name="IsAcquired" type="xs:boolean">
                                  <xs:annotation>
                                    <xs:documentation>Prevzete družbe v transakciji</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element minOccurs="1" maxOccurs="1" name="IsAcquiringOrNew" type="xs:boolean">
                                  <xs:annotation>
                                    <xs:documentation>Prevzemne/novoustanovljene družbe v transakciji</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element minOccurs="0" maxOccurs="1" name="Name" type="xs:string">
                                  <xs:annotation>
                                    <xs:documentation>Naziv</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element minOccurs="0" maxOccurs="1" name="TaxNumber">
                                  <xs:annotation>
                                    <xs:documentation>Davčna številka</xs:documentation>
                                  </xs:annotation>
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="20" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element minOccurs="1" maxOccurs="1" name="IsDebtEnforcement" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Davčni obračun pri začetku postopka prisilne poravnave (367. člen ZDavP-2)</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="1" maxOccurs="1" name="IsDissolvingCorporation" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Davčni obračun v primeru prenehanja davčnega zavezanca</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="1" name="DissolvingCorporationDetails">
                <xs:annotation>
                  <xs:documentation>Davčni obračun v primeru prenehanja davčnega zavezanca - podatki</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:annotation>
                    <xs:documentation>Davčni obračun v primeru prenehanja davčnega zavezanca</xs:documentation>
                  </xs:annotation>
                  <xs:sequence>
                    <xs:element minOccurs="1" maxOccurs="1" name="Bankruptcy">
                      <xs:annotation>
                        <xs:documentation>Prenehanje po stečajnem postopku (368. člen ZDavP-2):</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:enumeration value="None">
                            <xs:annotation>
                              <xs:documentation>ni izpolnjeno</xs:documentation>
                            </xs:annotation>
                          </xs:enumeration>
                          <xs:enumeration value="Before">
                            <xs:annotation>
                              <xs:documentation>davčni obračun na dan pred začetkom stečajnega postopka</xs:documentation>
                            </xs:annotation>
                          </xs:enumeration>
                          <xs:enumeration value="During">
                            <xs:annotation>
                              <xs:documentation>davčni obračun v času stečajnega postopka</xs:documentation>
                            </xs:annotation>
                          </xs:enumeration>
                          <xs:enumeration value="After">
                            <xs:annotation>
