<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="Doh_OdlKap_1"
    targetNamespace="http://edavki.durs.si/Documents/Schemas/Doh_OdlKap_1.xsd"
    elementFormDefault="qualified"
    xmlns="http://edavki.durs.si/Documents/Schemas/Doh_OdlKap_1.xsd"
    xmlns:mstns="http://edavki.durs.si/Documents/Schemas/Doh_OdlKap_1.xsd"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns:ds="http://www.w3.org/2000/09/xmldsig#" 
    xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd">
  <!-- Import the common schema -->
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd" id="EDP-Common-1"/>
  <!-- Root element of the document definition -->
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header" />
        <xs:element ref="edp:Signatures" />       
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent" />
              
              <xs:element name="DohOdlKap">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element ref="DohOdlKapHeader" />
                    <xs:element ref="RecipientInformation"  minOccurs="0" />
                    <xs:element ref="RealEstateInformation" minOccurs="0" />
                    <xs:element ref="SecuritiesSharesAndInvestmentAllowances" minOccurs="0" />
                    <xs:element ref="Custodian" minOccurs="0" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              
            </xs:sequence>            
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:element name="DohOdlKapHeader">
    <xs:annotation>
      <xs:documentation xml:lang="sl">
        Podatki o darovalcu
      </xs:documentation>
    </xs:annotation>

    <xs:complexType>
      <xs:sequence>
        <xs:element name="DocumentWorkflowID" type="edp:DocumentIDType" minOccurs="0">
          <xs:annotation>
            <xs:documentation>DocumentWorkflow ID</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="DocumentWorkflowName" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>DocumentWorkflowName</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="CorrectionForDocument" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>CorrectionForDocument</xs:documentation>
          </xs:annotation>
        </xs:element>
        
        <xs:element name="Resident" type="xs:boolean" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Rezident republike Slovenije
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        
        <xs:element name="ResidentCountry" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Država rezidentstva
            </xs:documentation>
          </xs:annotation>
        </xs:element>

        <xs:element name="Email" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Elektronski naslov
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="PhoneNumber" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Telefonska številka
            </xs:documentation>
          </xs:annotation>
        </xs:element>

        <xs:element name="TaxPeriod" type="xs:int" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Perioda
            </xs:documentation>
          </xs:annotation>
        </xs:element>

        <xs:element  name="TransmissionOffice" type="xs:string" minOccurs="1" >
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Urad pošiljanja
            </xs:documentation>
          </xs:annotation>
        </xs:element> 

      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <!--prva tabela: Podatki o prejemniku-->
  <xs:element name="RecipientInformation">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="RecipientInformationItem"  minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="RecipientInformationItem">
    <xs:complexType >
      <xs:sequence>        
        <xs:element name="Name" type="Text100Type" minOccurs="1">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Ime priimek oz. naziv pravne osebe
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Address" type="Text100Type" minOccurs="1">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Podatki o prebivališču (naselje, ulica, hišna številka, pošta)
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Country" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Država rezidenstva
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="TaxNumber" type="Text8Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Davčna ali indentifikacijska številka
            </xs:documentation>
          </xs:annotation>
        </xs:element>

        <xs:element name="BirthDate" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Datum rojstva
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        
        <xs:element name="BloodRelationship" type="xs:string" minOccurs="1">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Sorodstveno razmerje (prejemnika do darovalca)
            </xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element >

  <!--druga tabela: opis podarjenega mepremičnega premoženja zmeljišča - stavbe -->
  <xs:element name="RealEstateInformation">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="RealEstateInformationItem"  minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  
  <xs:element name="RealEstateInformationItem">
    <xs:annotation>
      <xs:documentation xml:lang="sl">
        Nepremičnina
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Id" type="xs:positiveInteger" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Zaporedna številka
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="RealEstateType" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Vrsta nepremičnine
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Address" type="Text100Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Naslov
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Municipality" type="Text50Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Katasterska Občina
            </xs:documentation>
          </xs:annotation>
        </xs:element>        
        <xs:element name="OtherInformation" type="Text50Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Drugi podatki
            </xs:documentation>
          </xs:annotation>
        </xs:element>                
        <xs:element name="Value" type="Decimal16_2Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Nabavna vrednost
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        
        <xs:element name="AcquisitionDate" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Datum pridobitve
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        
      </xs:sequence>
    </xs:complexType>
  </xs:element >
  
  <!--Securities and shares, and investment allowances-->
  <xs:element name="SecuritiesSharesAndInvestmentAllowances">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="SecuritiesSharesAndInvestmentAllowancesItem"  minOccurs="0" maxOccurs="unbounded" />
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="SecuritiesSharesAndInvestmentAllowancesItem">
    <xs:annotation>
      <xs:documentation xml:lang="sl">
        Vrednostni papirji in deleži ter investicijski kuponi
      </xs:documentation>
    </xs:annotation>

    <xs:complexType>
      <xs:sequence>
        <xs:element name="Id" type="xs:positiveInteger" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Zaporedna številka
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="TypeOfItem" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Vrsta
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        
        <xs:element name="OtherInformation" type="Text100Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Drugi podatki
            </xs:documentation>
          </xs:annotation>
        </xs:element>        
        
        <xs:element name="NumberOfItems" type="Text50Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Količina
            </xs:documentation>
          </xs:annotation>
        </xs:element>               
                
        <xs:element name="Value" type="Decimal16_2Type" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Nabavna vrednost
            </xs:documentation>
          </xs:annotation>
        </xs:element>
        
        <xs:element name="AcquisitionDate" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation xml:lang="sl">
              Datum pridobitve
            </xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element >

  <xs:element name="Custodian">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="CustodianNotes" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Custodian notes</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="CustodianSubmitDate" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Submission date</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>

  </xs:element>
  
  <!-- Used Types-->
  <xs:simpleType name="Decimal16_2Type">
    <xs:restriction base="xs:decimal">
      <xs:pattern value="\d{1,16}(\.\d{1,2})?" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Decimal14_2Type">
    <xs:restriction base="xs:decimal">
      <xs:pattern value="\d{1,14}(\.\d{1,2})?" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Text8Type">
    <xs:restriction base="xs:string">
      <xs:maxLength value="10"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Text10Type">
    <xs:restriction base="xs:string">
      <xs:maxLength value="10"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Text50Type">
    <xs:restriction base="xs:string">
      <xs:maxLength value="50"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="Text100Type">
    <xs:restriction base="xs:string">
      <xs:maxLength value="100"/>
    </xs:restriction>
  </xs:simpleType>
  
</xs:schema>

