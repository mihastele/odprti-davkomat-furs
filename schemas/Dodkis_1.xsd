<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns="http://edavki.durs.si/Documents/Schemas/Dodkis_1.xsd"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd"
  targetNamespace="http://edavki.durs.si/Documents/Schemas/Dodkis_1.xsd"
  elementFormDefault="qualified" >

  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd"/>

  <xs:element name="BaseEntity" id="Dodkis">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="DocumentWorkflowID" type="edp:DocumentIDType">
          <xs:annotation>
            <xs:documentation>Vrsta dokumenta - šifra</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="DocumentTypeName" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Vrsta dokumenta - naziv</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="CustodianNotes" type="xs:string" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Opombe</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="CustodianSubmitDate" type="xs:date" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Datum prijave</xs:documentation>
          </xs:annotation>
        </xs:element>

        <xs:element name="Period" type="xs:string">
          <xs:annotation>
            <xs:documentation>Obdobje (MM.YYYY)</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="TotalTax" type="xs:decimal" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Skupaj davek</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="TotalTaxRate" type="xs:decimal" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Skupaj davek stopnja</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Data1" id="Dobitek" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:annotation>
              <xs:documentation>Dobitek</xs:documentation>
            </xs:annotation>
            <xs:sequence>
              <xs:element name="F1" type="xs:int" id="SequenceNumber">
                <xs:annotation>
                  <xs:documentation>SequenceNumber</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F2" type="xs:string" id="Country" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Country</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F3" type="xs:int" id="TaxNumber" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>TaxNumber</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F4" type="xs:string" id="ID" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>ID</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F5" type="xs:string" id="Surname" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Surname</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F6" type="xs:string" id="Name" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Name</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F7" type="xs:string" id="Address" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Address</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F8" type="xs:string" id="PrizeType" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>PrizeType</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F9" type="xs:decimal" id="TaxBase" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>TaxBase</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F10" type="xs:decimal" id="TaxRate" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>TaxRate</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F11" type="xs:decimal" id="TaxAmount" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>TaxAmount</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F12" type="xs:string" id="CountryName" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>CountryName</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="Attachment" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="Hash" type="xs:string" minOccurs="0" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header"/>
        <xs:element ref="edp:Signatures"/>
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent"/>
              <xs:element ref="BaseEntity"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
