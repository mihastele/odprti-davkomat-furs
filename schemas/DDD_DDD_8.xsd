<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns="http://edavki.durs.si/Documents/Schemas/DDD_DDD_8.xsd" xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" elementFormDefault="qualified" targetNamespace="http://edavki.durs.si/Documents/Schemas/DDD_DDD_8.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:import schemaLocation="EDP-Common-1.xsd" namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" />
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header" />
        <xs:element ref="edp:Signatures" />
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent" />
              <xs:element ref="DDD_DDD" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="DDD_DDD">
    <xs:complexType>
      <xs:annotation>
        <xs:documentation>Obračun akontacije dohodnine in dohodnine od dohodka iz dejavnosti</xs:documentation>
      </xs:annotation>
      <xs:sequence>
        <xs:element minOccurs="1" maxOccurs="1" name="PeriodStart" type="xs:dateTime">
          <xs:annotation>
            <xs:documentation>Obdobje od</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="PeriodEnd" type="xs:dateTime">
          <xs:annotation>
            <xs:documentation>Obdobje do</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="VrstaOdhodkov">
          <xs:annotation>
            <xs:documentation>NAČIN UGOTAVLJANJA DAVČNE OSNOVE od dohodka iz dejavnosti v obdobju, za katerega se predlaga obračun:</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="Dejanski">
                <xs:annotation>
                  <xs:documentation>D – Dejanski: na podlagi dejanskih prihodkov in dejanskih odhodkov</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="Normirani">
                <xs:annotation>
                  <xs:documentation>N – Normirani: na podlagi dejanskih prihodkov in normiranih odhodkov</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="TaxSubjectExt">
          <xs:annotation>
            <xs:documentation>II. OSNOVNI PODATKI O ZAVEZANCU</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:annotation>
              <xs:documentation>Dodatni podatki o zavezancu</xs:documentation>
            </xs:annotation>
            <xs:sequence>
              <xs:element minOccurs="0" maxOccurs="1" name="Telephone" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Telefon</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="1" name="Mail" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Elektronski naslov</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="unbounded" name="ActivityCodeList">
                <xs:annotation>
                  <xs:documentation>Šifre dejavnosti po SKD</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="ActivityCode" type="xs:string" />
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="1" name="RegistrationNumber">
                <xs:annotation>
                  <xs:documentation>Matična številka obrata</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                  <xs:restriction base="xs:string">
                    <xs:length value="7" />
                  </xs:restriction>
                </xs:simpleType>
              </xs:element>
              <xs:element minOccurs="1" maxOccurs="1" name="Resident" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Zavezanec je rezident Republike Slovenije:</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="1" name="CountryForNonResident" type="xs:string">
                <xs:annotation>
                  <xs:documentation>Šifra države nerezidenta:</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="ActivitySlo">
          <xs:annotation>
            <xs:documentation>Dodatne dejavnosti v Sloveniji:</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element minOccurs="0" maxOccurs="unbounded" name="AddActivitySlo" nillable="true">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="RegistrationNumber" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Dodatna matična številka obrata</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="0" maxOccurs="1" name="AddressSlo" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Dodatni podatki o sedežu oziroma kraju poslovanja:</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="0" maxOccurs="1" name="CommunityCode" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Občina:</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="0" maxOccurs="1" name="ActivityCode">
                      <xs:annotation>
                        <xs:documentation>Dodatna šifra dejavnosti po SKD</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:length value="5" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="ActivityForeign">
          <xs:annotation>
            <xs:documentation>Dodatne dejavnosti v Sloveniji:</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element minOccurs="0" maxOccurs="unbounded" name="AddActivityForeign" nillable="true">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element minOccurs="0" maxOccurs="1" name="Country" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Dodatni sedež oziroma kraj poslovanja v državi (šifra države)</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="0" maxOccurs="1" name="AddressForeign" type="xs:string">
                      <xs:annotation>
                        <xs:documentation>Naslov</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="0" maxOccurs="1" name="ActivityCode">
                      <xs:annotation>
                        <xs:documentation>Dodatna šifra dejavnosti po SKD</xs:documentation>
                      </xs:annotation>
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:length value="5" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="AccountingType">
          <xs:annotation>
            <xs:documentation>Sistem vodenja poslovnih knjig</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:enumeration value="SingleEntry">
                <xs:annotation>
                  <xs:documentation>Enostavno knjigovodstvo</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="DoubleEntry">
                <xs:annotation>
                  <xs:documentation>Dvostavno knjigovodstvo</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
              <xs:enumeration value="Records">
                <xs:annotation>
                  <xs:documentation>Evidence</xs:documentation>
                </xs:annotation>
              </xs:enumeration>
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="SocialSecurityType1" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Obvezno socialno zavarovanje iz naslova opravljanja dejavnosti</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="SocialSecurityType1Amount" nillable="true" type="money">
          <xs:annotation>
            <xs:documentation>Socialno zavarovanje iz naslova opravljanja dejavnosti - obračunani znesek prispevkov za socialno varnost v tem poslovnem letu</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="SocialSecurityType2" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Obvezno socialno zavarovanje iz delovnega razmerja</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="SocialSecurityType3" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Obvezno socialno zavarovanje v skladu z drugim odstavkom 56. člena ZDoh-2</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="SocialSecurityType3Country" type="xs:string">
          <xs:annotation>
            <xs:documentation>Obvezno socialno zavarovanje v skladu z drugim odstavkom 56. člena ZDoh-2 - država sklada v katerega se plačujejo prispevki za socialno varnost</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="SocialSecurityType3Amount" nillable="true" type="money">
          <xs:annotation>
            <xs:documentation>Obvezno socialno zavarovanje v skladu z drugim odstavkom 56. člena ZDoh-2 - višina prispevkov je v tem poslovnem letu</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="SocialSecurityType4" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Druge vrste obveznega socialnega zavarovanja</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="BenefitType1" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Uveljavljanje ugodnosti po ZDoh-2 - Izjavljam, da sem rezident Slovenije, samostojno opravljam specializiran poklic na področju kulturne dejavnosti in sem vpisan v razvid samozaposlenih v kulturi, nimam sklenjenega delovnega razmerja in ne opravljam druge dejavnosti, zato uveljavljam zmanjšanje davčne osnove od dohodka iz dejavnosti v višini 15 odstotkov prihodkov.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="BenefitType1Occupation">
          <xs:annotation>
            <xs:documentation>Uveljavljanje ugodnosti po ZDoh-2 - Specializiran poklic na področju kulturne dejavnosti</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="75" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="BenefitType1Evidence">
          <xs:annotation>
            <xs:documentation>Uveljavljanje ugodnosti po ZDoh-2 - Razvid samozaposlenih v kulturi</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="75" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="BenefitType2" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Uveljavljanje ugodnosti po ZDoh-2 - Izjavljam, da sem rezident Slovenije, samostojno opravljam novinarski poklic in sem vpisan v razvid samostojnih novinarjev, nimam sklenjenega delovnega razmerja in ne opravljam druge dejavnosti, zato uveljavljam zmanjšanje davčne osnove od dohodka iz dejavnosti v višini 15 odstotkov prihodkov.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="BenefitType2Occupation">
          <xs:annotation>
            <xs:documentation>Uveljavljanje ugodnosti po ZDoh-2 - Novinarski poklic</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="75" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="BenefitType2Evidence">
          <xs:annotation>
            <xs:documentation>Uveljavljanje ugodnosti po ZDoh-2 - Razvid samostojnih novinarjev</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="75" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="BenefitType4" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Uveljavljanje ugodnosti po ZDoh-2 - Izjavljam, da sem rezident Slovenije, samostojno opravljam športni poklic in sem vpisan v razvid poklicnih športnikov, nimam sklenjenega delovnega razmerja in ne opravljam druge dejavnosti, zato uveljavljam zmanjšanje davčne osnove od dohodka iz dejavnosti v višini 15 odstotkov prihodkov.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="BenefitType4Occupation">
          <xs:annotation>
            <xs:documentation>Uveljavljanje ugodnosti po ZDoh-2 - Športni poklic</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="75" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="0" maxOccurs="1" name="BenefitType4Evidence">
          <xs:annotation>
            <xs:documentation>Uveljavljanje ugodnosti po ZDoh-2 - Razvid poklicnih športnikov</xs:documentation>
          </xs:annotation>
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="75" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="BenefitType3" type="xs:boolean">
          <xs:annotation>
            <xs:documentation>Uveljavljanje ugodnosti po ZDoh-2 - Izjavljam, da sem v zadnjih petih letih uveljavljal davčno obravnavo po 4. odstavku 51. člena ZDoh-2</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element minOccurs="1" maxOccurs="1" name="AssessmentOfTaxStatus">
          <xs:annotation>
            <xs:documentation>IV. PODATKI O VRSTI OBRAČUNA (ustrezno označite)</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:annotation>
              <xs:documentation>PODATKI O VRSTI OBRAČUNA (ustrezno označite)</xs:documentation>
            </xs:annotation>
            <xs:sequence>
              <xs:element minOccurs="1" maxOccurs="1" name="IsAssessmentOfTaxRegular" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Redni letni obračun</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="1" maxOccurs="1" name="IsRegularTermination" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Obračun pri prenehanju davčnega zavezanca z izbrisom iz Poslovnega registra dne:</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="1" name="RegularTerminationDetails">
                <xs:annotation>
                  <xs:documentation>Obračun pri prenehanju davčnega zavezanca z  izbrisom iz Poslovnega registra - podatki</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:annotation>
                    <xs:documentation>Obračun pri prenehanju davčnega zavezanca z  izbrisom iz Poslovnega registra - podatki</xs:documentation>
                  </xs:annotation>
                  <xs:sequence>
                    <xs:element minOccurs="1" maxOccurs="1" name="RegistryRemovalDate" nillable="true" type="xs:dateTime">
                      <xs:annotation>
                        <xs:documentation>Datum izbrisa iz poslovnega registra</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element minOccurs="1" maxOccurs="1" name="IsExtraordinaryTermination" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Obračun pri izrednem prenehanju davčnega zavezanca</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="1" name="ExtraordinaryTerminationDetails">
                <xs:annotation>
                  <xs:documentation>Obračun pri izrednem prenehanju davčnega zavezanca - podatki</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:annotation>
                    <xs:documentation>Obračun pri izrednem prenehanju davčnega zavezanca</xs:documentation>
                  </xs:annotation>
                  <xs:sequence>
                    <xs:element minOccurs="1" maxOccurs="1" name="IsDeath" type="xs:boolean">
                      <xs:annotation>
                        <xs:documentation>Obračun zaradi smrti:</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="1" maxOccurs="1" name="DateOfDeath" nillable="true" type="xs:dateTime">
                      <xs:annotation>
                        <xs:documentation>Datum smrti</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="1" maxOccurs="1" name="IsPersonalBankruptcy" type="xs:boolean">
                      <xs:annotation>
                        <xs:documentation>Obračun zaradi osebnega stečaja:</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="1" maxOccurs="1" name="DateOfPersonalBankruptcy" nillable="true" type="xs:dateTime">
                      <xs:annotation>
                        <xs:documentation>Datum osebnega stečaja</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
              <xs:element minOccurs="1" maxOccurs="1" name="IsStatusChange" type="xs:boolean">
                <xs:annotation>
                  <xs:documentation>Obračun pri prenehanju davčnega zavezanca s statusno spremembo vpisano v Sodni register dne</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element minOccurs="0" maxOccurs="1" name="StatusChangeDetails">
                <xs:annotation>
                  <xs:documentation>Obračun pri prenehanju davčnega zavezanca s statusno spremembo vpisano v Sodni register - podatki</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                  <xs:annotation>
                    <xs:documentation>Obračun pri prenehanju davčnega zavezanca s statusno spremembo vpisano v Sodni register dne - podatki</xs:documentation>
                  </xs:annotation>
                  <xs:sequence>
                    <xs:element minOccurs="1" maxOccurs="1" name="RegistrationDate" nillable="true" type="xs:dateTime">
                      <xs:annotation>
                        <xs:documentation>Dan vpisa v sodni register:</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="1" maxOccurs="1" name="IsGospodarskaDruzba" type="xs:boolean">
                      <xs:annotation>
                        <xs:documentation>V okviru statusnega preoblikovanja podjetnika po Zakonu o gospodarskih družbah</xs:documentation>
                      </xs:annotation>
                    </xs:element>
                    <xs:element minOccurs="0" maxOccurs="1" name="GospodarskaDruzbaDetails">
                      <xs:annotation>
                        <xs:documentation>V okviru statusnega preoblikovanja podjetnika po Zakonu o gospodarskih družbah - podatki</xs:documentation>
                      </xs:annotation>
                      <xs:complexType>
                        <xs:annotation>
                          <xs:documentation>v okviru statusnega preoblikovanja podjetnika po Zakonu o gospodarskih družbah</xs:documentation>
                        </xs:annotation>
                        <xs:sequence>
                          <xs:element minOccurs="1" maxOccurs="1" name="IsNovaKapitalskaDruzba" type="xs:boolean">
                            <xs:annotation>
                              <xs:documentation>zaradi prenosa podjetja na novo kapitalsko družbo s podatki:</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element minOccurs="0" maxOccurs="1" name="NovaKapitalskaDruzbaData">
                            <xs:annotation>
                              <xs:documentation>zaradi prenosa podjetja na novo kapitalsko družbo s podatki - podatki</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element minOccurs="0" maxOccurs="1" name="Name" type="xs:string">
                                  <xs:annotation>
                                    <xs:documentation>Naziv:</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element minOccurs="0" maxOccurs="1" name="Address" type="xs:string">
                                  <xs:annotation>
                                    <xs:documentation>Naslov:</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element minOccurs="0" maxOccurs="1" name="TaxNumber">
                                  <xs:annotation>
                                    <xs:documentation>Davčna številka:</xs:documentation>
                                  </xs:annotation>
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:length value="8" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element minOccurs="1" maxOccurs="1" name="IsPripojitevKKapatalskiDruzbi" type="xs:boolean">
                            <xs:annotation>
                              <xs:documentation>zaradi prenosa prenosa podjetja na prevzemno kapitalsko družbo s podatki:</xs:documentation>
                            </xs:annotation>
                          </xs:element>
                          <xs:element minOccurs="0" maxOccurs="1" name="PripojitevKKapatalskiDruzbiData">
                            <xs:annotation>
                              <xs:documentation>zaradi prenosa prenosa podjetja na prevzemno kapitalsko družbo - podatki</xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element minOccurs="0" maxOccurs="1" name="Name" type="xs:string">
                                  <xs:annotation>
                                    <xs:documentation>Naziv:</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element minOccurs="0" maxOccurs="1" name="Address" type="xs:string">
                                  <xs:annotation>
                                    <xs:documentation>Naslov:</xs:documentation>
                                  </xs:annotation>
                                </xs:element>
                                <xs:element minOccurs="0" maxOccurs="1" name="TaxNumber">
                                  <xs:annotation>
                                    <xs:documentation>Davčna številka:</xs:documentation>
                                  </xs:annotation>
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:length value="8" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                              </xs:sequence>
