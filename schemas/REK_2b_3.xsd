<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://edavki.durs.si/Documents/Schemas/REK_2b_3.xsd" elementFormDefault="qualified" xmlns="http://edavki.durs.si/Documents/Schemas/REK_2b_3.xsd" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns:edp="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" xmlns:podo="http://edavki.durs.si/Documents/Schemas/PODO-Common-1.xsd">
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/EDP-Common-1.xsd" schemaLocation="EDP-Common-1.xsd" id="EDP-Common-1" />
  <xs:import namespace="http://edavki.durs.si/Documents/Schemas/PODO-Common-1.xsd" schemaLocation="PODO-Common-1.xsd" id="PODO-Common-1" />
  <xs:element name="REK">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="REK_2b">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="CorrectionForDocument" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Popravek Dokumenta</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="ControlerCode" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Šifra kontrolorja</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F005_Name" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Pooblascenec: Firma oz/ ime in priimek</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F006_Address" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Naslov</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F007_TaxPayerID" type="xs:int" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Davčna številka</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F10_IncomeType" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Vrsta izplačila</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F11_MonthYear" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Za mesec (MM.YYYY)</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F12_PaymentDate" type="xs:date" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Za mesec (YYYY-MM-DD)</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F13_EmployeesResident" type="xs:int" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Število zaposlenih (rezidentov)</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F13a" type="xs:int" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Št. oseb iz zap. št. 105</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F14_EmployeesNonResident" type="xs:int" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Število zaposlenih (nerezidentov)</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F15_NetPayment" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Neto izplačilo</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F101" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Dohodek</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F102" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Dohodek izplačan nerezidentom</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F103Z" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Dohodek ki se všteva v davčno osnovo</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F103S" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Stopnja</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F104" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Davčna osnova - nerezidenti, ki uveljavljajo ugodnosti iz mednarodnih pogodb</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F105" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Dohodek rezidentov</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F105_Prm" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Dohodek rezidentov - Znesek</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F201R" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Račun</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F201Z" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Davčni odtegljaj</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F202S" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Stopnja</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F202R" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Račun</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F202Z" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Davčni odtegljaj po nižji stopnji (245. čl. ZDavP-1)</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F203R" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Račun</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="F203Z" type="edp:Decimal14_2Type" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>SKUPAJ</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="CustodianNotes" type="xs:string" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Opombe</xs:documentation>
                </xs:annotation>
              </xs:element>
              <xs:element name="SubmitDate" type="xs:date" minOccurs="0">
                <xs:annotation>
                  <xs:documentation>Datum prijave</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element ref="podo:NER" minOccurs="0" maxOccurs="1">
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="Envelope">
    <xs:complexType>
      <xs:sequence>
        <xs:element ref="edp:Header" />
        <xs:element ref="edp:Signatures" />
        <xs:element name="body">
          <xs:complexType>
            <xs:sequence>
              <xs:element ref="edp:bodyContent" />
              <xs:element ref="REK">
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
